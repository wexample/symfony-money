{
  "name": "wexample/symfony-money",
  "description": "Symfony helpers to manage money, currencies and priced entities",
  "type": "library",
  "license": "MIT",
  "version": "5.0.2",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyMoney\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyMoney\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-helpers": ">=14.0.0",
    "wexample/symfony-api": ">=9.0.0",
    "wexample/symfony-forms": ">=10.0.0",
    "wexample/php-pseudocode": ">=1.0.0",
    "wexample/symfony-pseudocode": ">=3.0.0",
    "symfony/intl": ">=6.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}